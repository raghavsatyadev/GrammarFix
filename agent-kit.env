# Single config file for the agent scripts (same format as the Android Agent Kit).
APP_MODULE=:androidCMP
# Build variant for compile/assemble/test tasks, e.g. DevDebug when the app has flavors.
APP_VARIANT=Debug
APPLICATION_ID=com.raghavsatyadev.grammarfix
BASE_BRANCH=development
# Pin a ktfmt version (blank = latest release from Maven Central).
KTFMT_VERSION=
# Android NDK version that setup-env checks (blank = skip the check).
NDK_VERSION=30.0.15729638
